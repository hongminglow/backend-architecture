# Runtime profile
NODE_ENV=development
LOG_LEVEL=info

# Public ports
PUBLIC_HTTP_PORT=8080
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
RABBITMQ_MANAGEMENT_PORT=15672

# API service
API_PORT=3000
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET_AT_LEAST_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_AT_LEAST_32_CHARS
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
CORS_ALLOWED_ORIGINS=http://localhost:8080
TRUSTED_PROXY_CIDRS=127.0.0.1,::1

# Database
POSTGRES_DB=backend_playground
POSTGRES_USER=playground
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
DATABASE_URL=postgres://playground:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/backend_playground
API_DATABASE_URL=postgres://playground:CHANGE_ME_POSTGRES_PASSWORD@pgbouncer:6432/backend_playground

# PgBouncer
PGBOUNCER_PORT=6432
PGBOUNCER_MAX_CLIENT_CONN=1000
PGBOUNCER_DEFAULT_POOL_SIZE=40
PGBOUNCER_MIN_POOL_SIZE=5
PGBOUNCER_RESERVE_POOL_SIZE=10

# Redis
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379
CACHE_ENABLED=true
CACHE_TTL_SECONDS=60
CACHE_TIMEOUT_MS=200
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Auth abuse controls
AUTH_FAILED_LOGIN_IP_LIMIT=10
AUTH_FAILED_LOGIN_IP_WINDOW_SECONDS=60
AUTH_FAILED_LOGIN_ACCOUNT_LIMIT=5
AUTH_FAILED_LOGIN_ACCOUNT_WINDOW_SECONDS=900
AUTH_ACCOUNT_LOCK_SECONDS=900

# RabbitMQ
RABBITMQ_DEFAULT_USER=playground
RABBITMQ_DEFAULT_PASS=CHANGE_ME_RABBITMQ_PASSWORD
RABBITMQ_URL=amqp://playground:CHANGE_ME_RABBITMQ_PASSWORD@rabbitmq:5672
RABBITMQ_EXCHANGE=orders
RABBITMQ_ORDER_CREATED_QUEUE=order.created

# Outbox publisher
OUTBOX_PORT=3001
OUTBOX_BATCH_SIZE=100
OUTBOX_POLL_INTERVAL_MS=1000

# Worker service
WORKER_PORT=3002
WORKER_PROCESSING_TIMEOUT_MS=30000
WORKER_RETRY_DELAY_MS=5000
